{
  "rules": {
    ".read": false,
    ".write": false,
    "cown": {
      "$C": {
        ".read": false,
        ".write": "!data.exists() && $C.matches(/^[A-HJ-NP-Z2-9]{6}$/)",
        ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9]{24}$/)"
      }
    },
    "tc": {
      "$C": {
        "$T": {
          ".read": "root.child('cown').child($C).val() === $T",
          ".write": "newData.parent().parent().parent().child('cown').child($C).val() === $T",
          "info": { ".validate": "newData.isString() && newData.val().length <= 4000" },
          "pins": {
            "$no": { ".validate": "$no.matches(/^[1-9][0-9]{0,2}$/) && newData.isString() && newData.val().matches(/^[0-9]{4}$/)" }
          },
          "tasks": {
            "$id": { ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,24}$/) && newData.isString() && newData.val().length <= 20000" }
          },
          "live": { ".validate": "newData.isString() && newData.val().length <= 4000" },
          "notes": {
            "$no": { ".validate": "newData.isString() && newData.val().length <= 4000" }
          },
          "$other": { ".validate": false }
        }
      }
    },
    "k": {
      "$C": {
        "$no": {
          "$pin": {
            ".read": "root.child('cown').child($C).exists() && root.child('tc').child($C).child(root.child('cown').child($C).val()).child('pins').child($no).val() === $pin",
            ".write": "root.child('cown').child($C).exists() && root.child('tc').child($C).child(root.child('cown').child($C).val()).child('pins').child($no).val() === $pin",
            "r": {
              "$id": { ".validate": "$id.matches(/^[A-Za-z0-9_.-]{1,40}$/) && newData.isString() && newData.val().length <= 8000" }
            },
            "st": { ".validate": "newData.isString() && newData.val().length <= 30000" },
            "in": {
              "$id": { ".validate": "$id.matches(/^[A-Za-z0-9_-]{1,24}$/) && newData.isString() && newData.val().length <= 20000" }
            },
            "now": { ".validate": "newData.isString() && newData.val().length <= 1000" },
            "rv": { ".validate": "newData.isString() && newData.val().length <= 20000" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
